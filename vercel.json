{
  "version": 2,
  "framework": "vite",
 
  "buildCommand": "pnpm install --ignore-scripts && pnpm run build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install --ignore-scripts",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
